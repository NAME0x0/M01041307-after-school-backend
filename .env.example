# Copy this file to .env (git-ignored) and fill in the real values.
# NEVER commit .env, and never paste the real connection string anywhere public.
# On render.com these are set in the service's Environment settings instead
# (MONGODB_URI is entered once when the Blueprint is created).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=afterschool
PORT=3000
